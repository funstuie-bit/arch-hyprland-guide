[Unit]
Description=Share the existing Hyprland desktop with VNC
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/wayvnc/config

[Service]
Type=simple
ExecStart=/usr/bin/wayvnc --config=%h/.config/wayvnc/config --output=DP-1 --disable-resizing --max-fps=30 --name=Arch-Mac-mini
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=graphical-session.target
