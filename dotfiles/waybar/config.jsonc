{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/menu",
        "custom/term",
        "custom/browser",
        "custom/files",
        "custom/shortcuts",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "network",
        "custom/clipboard",
        "tray",
        "custom/power"
    ],

    "custom/menu": {
        "format": "  Start",
        "tooltip-format": "Applications Menu\nLeft-click: Open App Launcher (Super + Space)\nRight-click: Shortcuts Cheatsheet (Super + K)",
        "on-click": "rofi -show drun -show-icons",
        "on-click-right": "/home/stu/.config/hypr/bin/shortcuts-menu.sh"
    },

    "custom/term": {
        "format": "",
        "tooltip-format": "Terminal (Super + Return)",
        "on-click": "foot"
    },

    "custom/browser": {
        "format": "󰈹",
        "tooltip-format": "Web Browser (Super + B)",
        "on-click": "xdg-open http:// || firefox || zen-browser || chromium"
    },

    "custom/files": {
        "format": "󰝰",
        "tooltip-format": "File Manager (Super + E)",
        "on-click": "thunar"
    },

    "custom/shortcuts": {
        "format": "󰌌",
        "tooltip-format": "Shortcuts Cheatsheet (Super + K)",
        "on-click": "/home/stu/.config/hypr/bin/shortcuts-menu.sh"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "󰃰  {:%a %b %d · %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip": true,
        "interval": 2
    },

    "memory": {
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used",
        "interval": 2
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤮  Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "tooltip-format": "Clipboard History (Super + Ctrl + V)",
        "on-click": "/home/stu/.config/hypr/bin/clipboard-history.sh"
    },

    "custom/shortcuts": {
        "format": "󰌌",
        "tooltip-format": "Shortcuts Cheatsheet (Super + K)",
        "on-click": "/home/stu/.config/hypr/bin/shortcuts-menu.sh"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "System Power Menu (Super + Escape)",
        "on-click": "/home/stu/.config/hypr/bin/system-menu.sh"
    }
}
