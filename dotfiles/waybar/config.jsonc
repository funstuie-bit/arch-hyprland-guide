{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/menu",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "network",
        "custom/clipboard",
        "custom/shortcuts",
        "tray",
        "custom/power"
    ],

    "custom/menu": {
        "format": "",
        "tooltip-format": "App Launcher\nLeft-click: Application Launcher (Super + Space)\nRight-click: Foot Terminal (Super + Return)",
        "on-click": "rofi -show drun -show-icons",
        "on-click-right": "foot"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 45,
        "separate-outputs": true,
        "on-click": "hyprctl dispatch togglefloating activewindow",
        "on-click-right": "hyprctl dispatch killactive",
        "tooltip-format": "{title}\nLeft-click: Toggle Float / Tile\nRight-click: Close Window"
    },

    "clock": {
        "format": "󰃰  {:%a %b %d · %I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>\nLeft-click: Visual Calendar\nRight-click: Power Menu",
        "on-click": "foot -T 'Calendar' -e sh -c 'cal -3; echo; read -n 1 -s -r -p \"Press any key to close...\"'",
        "on-click-right": "/home/stu/.config/hypr/bin/system-menu.sh"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{desc}\nVolume: {volume}%\nLeft-click: Mute / Unmute\nRight-click: Sound Mixer (pavucontrol)\nScroll: Adjust Volume",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip-format": "CPU Usage: {usage}%\nLeft-click: Activity Monitor (btop)\nRight-click: Terminal",
        "interval": 2,
        "on-click": "foot -T \"Activity Monitor (btop)\" -e btop",
        "on-click-right": "foot"
    },

    "memory": {
        "format": "  {percentage}%",
        "tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\nLeft-click: Activity Monitor (btop)\nRight-click: Terminal",
        "interval": 2,
        "on-click": "foot -T \"Activity Monitor (btop)\" -e btop",
        "on-click-right": "foot"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤮  Offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nLeft-click: Network Connections GUI\nRight-click: Terminal Setup (nmtui)",
        "on-click": "nm-connection-editor",
        "on-click-right": "foot -T 'Network Setup' -e nmtui"
    },

    "custom/clipboard": {
        "format": "󰅍",
        "tooltip-format": "Clipboard History\nLeft-click: Open History Picker\nRight-click: Clear History",
        "on-click": "/home/stu/.config/hypr/bin/clipboard-history.sh",
        "on-click-right": "cliphist wipe && notify-send 'Clipboard' 'History cleared'"
    },

    "custom/shortcuts": {
        "format": "󰌌",
        "tooltip-format": "Shortcuts Cheatsheet\nLeft-click: Search Shortcuts\nRight-click: App Launcher",
        "on-click": "/home/stu/.config/hypr/bin/shortcuts-menu.sh",
        "on-click-right": "rofi -show drun -show-icons"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Power & Session\nLeft-click: Power Menu\nRight-click: Lock Screen",
        "on-click": "/home/stu/.config/hypr/bin/system-menu.sh",
        "on-click-right": "hyprlock"
    }
}
