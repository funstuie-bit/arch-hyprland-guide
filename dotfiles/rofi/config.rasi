/**
 * Spotlight / Raycast Style Rofi Theme
 * Sleek, translucent, modern dark aesthetic
 */

configuration {
    modi:                       "drun,run,window";
    font:                       "JetBrainsMono Nerd Font 13";
    show-icons:                 true;
    icon-theme:                 "Papirus-Dark";
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name}";
    hover-select:               true;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

* {
    /* Catppuccin Mocha palette */
    bg:                         rgba(24, 24, 37, 0.94);
    bg-alt:                     rgba(30, 30, 46, 0.75);
    fg:                         #cdd6f4;
    fg-dim:                     #a6adc8;
    fg-muted:                   #6c7086;
    accent:                     #cba6f7;
    accent-alt:                 #89b4fa;
    selected-bg:                rgba(203, 166, 247, 0.18);
    selected-border:            rgba(203, 166, 247, 0.45);
    border-subtle:              rgba(255, 255, 255, 0.08);

    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0;
    padding:                    0;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    width:                      640px;
    x-offset:                   0;
    y-offset:                   -60px;
    border-radius:              16px;
    border:                     1px;
    border-color:               @border-subtle;
    background-color:           @bg;
    padding:                    16px;
    cursor:                     "default";
}

mainbox {
    enabled:                    true;
    spacing:                    10px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    12px;
    background-color:           @bg-alt;
    border-radius:              10px;
    border:                     1px;
    border-color:               @border-subtle;
    padding:                    12px 16px;
    text-color:                 @fg;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    true;
    font:                       "JetBrainsMono Nerd Font 14";
    text-color:                 @accent;
    vertical-align:             0.5;
}

entry {
    enabled:                    true;
    font:                       "JetBrainsMono Nerd Font 13";
    text-color:                 @fg;
    cursor:                     text;
    placeholder:                "Type to search...";
    placeholder-color:          @fg-muted;
    vertical-align:             0.5;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      7;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    4px;
    background-color:           transparent;
    text-color:                 @fg;
}

element {
    enabled:                    true;
    spacing:                    14px;
    padding:                    9px 12px;
    border-radius:              8px;
    border:                     1px;
    border-color:               transparent;
    background-color:           transparent;
    text-color:                 @fg;
    cursor:                     pointer;
    children:                   [ "element-icon", "element-text" ];
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @fg;
    border-color:               transparent;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
    border-color:               transparent;
}

element selected.normal {
    background-color:           @selected-bg;
    text-color:                 #ffffff;
    border-color:               @selected-border;
}

element normal.active {
    background-color:           transparent;
    text-color:                 @accent-alt;
    border-color:               transparent;
}

element alternate.active {
    background-color:           transparent;
    text-color:                 @accent-alt;
    border-color:               transparent;
}

element selected.active {
    background-color:           @selected-bg;
    text-color:                 #ffffff;
    border-color:               @selected-border;
}

element-icon {
    background-color:           transparent;
    size:                       26px;
    cursor:                     inherit;
    vertical-align:             0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font 13";
}

message {
    background-color:           transparent;
}

textbox {
    padding:                    10px;
    border-radius:              8px;
    background-color:           @bg-alt;
    text-color:                 @fg;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

error-message {
    padding:                    15px;
    border-radius:              8px;
    background-color:           @bg;
    text-color:                 #f38ba8;
}
